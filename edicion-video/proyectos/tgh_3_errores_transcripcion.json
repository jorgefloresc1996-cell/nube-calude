[{"start": 0.0, "end": 2.12, "text": "Tres errores que hacen que tus redes se vean."}, {"start": 2.12, "end": 3.36, "text": "Pocos profesionales"}, {"start": 3.36, "end": 5.34, "text": "Puede que estés cometiendo estos tres errores."}, {"start": 5.34, "end": 7.3, "text": "Error 1. Usar colores y estres."}, {"start": 7.3, "end": 9.32, "text": "si los diferentes en cada publicación."}, {"start": 9.32, "end": 10.84, "text": "define tu linea gráfica."}, {"start": 10.84, "end": 12.98, "text": "Error 2. Saturar tus diseños."}, {"start": 12.98, "end": 14.18, "text": "Pusa texto breve si."}, {"start": 14.18, "end": 16.02, "text": "Claros para facilitar la lectura."}, {"start": 16.02, "end": 17.02, "text": "Error 3"}, {"start": 17.02, "end": 18.74, "text": "PULICAR SIN ESTRATEJIA"}, {"start": 18.74, "end": 20.92, "text": "Organiza tus contenidos con anticipación."}, {"start": 20.92, "end": 22.58, "text": "¿Cometes alguno de estos errores?"}, {"start": 22.58, "end": 23.92, "text": "Comentanos en los comentarios."}]